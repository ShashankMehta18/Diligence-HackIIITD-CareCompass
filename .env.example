# Separate Groq accounts. Backend only; never paste credentials in chat.
GROQ_TEXT_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_AUDIO_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
# auto: live when text key exists, otherwise labelled local rules baseline
# rules: deterministic offline baseline; live: fail closed without a working key
TEXT_MODE=auto
# Fixed reproducible synthetic-data clock. Use now for a live-time demonstration.
REFERENCE_TIME=2026-10-24T08:00:00+05:30

